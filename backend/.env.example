# ============================================
# BillFlow Backend — Local Environment Config
# ============================================
# Set ENV to "local" for local dev, "aws" for production
ENV=local

PORT=4000

# ---- Local DB credentials (used when ENV=local) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billflow_db
DB_USER=billflow_admin
DB_PASSWORD=YourLocalPassword123!

# ---- JWT (used when ENV=local) ----
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ---- AWS (used when ENV=aws) ----
AWS_REGION=ap-south-1
AWS_SECRET_NAME=billflow/production/secrets

# ---- Frontend URL for CORS ----
FRONTEND_URL=http://localhost:5173
